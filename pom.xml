<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  pom-scijava 43.0.0 deliberately matches CPC's, not oc3d-core's 31.1.0.
	  The parent decides which net.imagej:ij the module compiles against, and a
	  bit-identity gate is only meaningful if the engine and the plugin that
	  embeds it agree on it. Both currently resolve 1.53f; matching the plugin
	  keeps that true when either moves.
	-->
	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>43.0.0</version>
		<relativePath/>
	</parent>

	<groupId>io.github.jay2owe</groupId>
	<artifactId>cpc-core</artifactId>
	<version>0.2.0-SNAPSHOT</version>

	<name>cpc-core</name>
	<description>Centre-Particle Coincidence as an embeddable engine: is an object's centroid inside an object in another channel? Returns result models, never ImageJ tables, and runs headless. Shaded into each consuming plugin under a private package name; never shipped to users as a jar.</description>
	<url>https://github.com/Jay2owe/CPC</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>UK Dementia Research Institute at Imperial College London</name>
		<url>https://ukdri.ac.uk/centres/imperial</url>
	</organization>

	<!--
	  BSD-3-Clause with no asterisk. This module links net.imagej:ij (ImageJ 1.x,
	  public domain) through oc3d-core and nothing else, so a consumer that
	  shades it in inherits no obligation from it. See ../PLUGIN_CORE_PATTERN.md.
	-->
	<licenses>
		<license>
			<name>BSD 3-Clause License</name>
			<url>https://opensource.org/licenses/BSD-3-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>Jay2owe</id>
			<name>Jamie Malcolm</name>
			<email>jamiemalcolm12@gmail.com</email>
			<url>https://github.com/Jay2owe</url>
			<organization>UK Dementia Research Institute at Imperial College London</organization>
			<organizationUrl>https://www.ukdri.ac.uk/labs/brancaccio-lab</organizationUrl>
			<properties>
				<orcid>0009-0008-3862-2776</orcid>
			</properties>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Jamie Malcolm</name>
			<url>https://github.com/Jay2owe</url>
			<properties><id>Jay2owe</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imagej</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/Jay2owe/CPC</connection>
		<developerConnection>scm:git:git@github.com:Jay2owe/CPC</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/Jay2owe/CPC</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Jay2owe/CPC/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/Jay2owe/CPC/actions</url>
	</ciManagement>

	<properties>
		<package-name>sc.fiji.cpc.core</package-name>
		<license.licenseName>bsd_3</license.licenseName>
		<license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
		<!--
		  Never published. This module is compiled into its consumers, so a
		  deploy would put a second copy of these classes on the classpath and
		  let two plugins disagree about which version loaded.
		-->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		  The entire dependency list. oc3d-core supplies label semantics and the
		  centroid scan; it brings net.imagej:ij and nothing else.
		-->
		<dependency>
			<groupId>io.github.jay2owe</groupId>
			<artifactId>oc3d-core</artifactId>
			<version>0.1.0</version>
		</dependency>

		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
